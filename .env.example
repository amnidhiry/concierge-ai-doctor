# Copy this file to `.env` and fill in your keys. `.env` is gitignored.
#
#   cp .env.example .env
#
# Everything here is read by the Vite dev-server middleware (server/*.js), which
# runs in Node. None of it is bundled into the browser build. Do NOT prefix any
# of these with VITE_, or Vite will inline them into the client bundle and expose
# them in devtools.
#
# Note: Vite's loadEnv also merges matching process.env entries, so a value
# exported in your shell is picked up even with no .env file. The dev server logs
# which source each credential came from at startup.

# --- Anthropic (Step 1 triage agent + Step 2 synthesis) ---------------------

ANTHROPIC_API_KEY=

# Optional. Structured output is forced via tool + tool_choice, which works on
# every current model, so this can be swapped without code changes.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=8000

# --- LiveKit (video visits) -------------------------------------------------
#
# From https://cloud.livekit.io → your project:
#   LIVEKIT_URL         Project overview / Settings → Project. Starts with wss://
#   LIVEKIT_API_KEY     Settings → Keys. Starts with "API"
#   LIVEKIT_API_SECRET  Settings → Keys. Shown ONCE at key creation — if lost,
#                       delete the key and create a new pair.
#
# The API secret is the credential for the entire project: it can mint a token
# for any room. It is only ever read server-side, in server/livekitToken.js.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
