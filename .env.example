# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
#   cp .env.example .env
#
# The key is read by the Vite dev-server middleware (server/anthropicProxy.js),
# which runs in Node — it is never bundled into the browser build and never
# reaches the client. Do NOT prefix it with VITE_, or Vite will inline it into
# the client bundle and expose it in devtools.

ANTHROPIC_API_KEY=

# Optional overrides.
#
# ANTHROPIC_MODEL: defaults to claude-sonnet-4-6.
# Structured output here is forced via a single tool + tool_choice, which works
# on every current model, so you can swap this for claude-opus-5 or
# claude-sonnet-5 without touching code.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ANTHROPIC_MAX_TOKENS: defaults to 8000.
# ANTHROPIC_MAX_TOKENS=8000
